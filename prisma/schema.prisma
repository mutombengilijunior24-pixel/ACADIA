// ============================================================
// ACADIA — SCHÉMA DE BASE DE DONNÉES (P17)
//
// SQLite en développement (base réelle, transactionnelle, fichier
// local — aucun serveur externe requis, voir
// ACADIA_P17_PRODUCTION_ARCHITECTURE.md). PostgreSQL documenté
// comme cible de production : changer `provider` + `DATABASE_URL`
// suffit, ce schéma reste valide (SQLite ne supportant pas les
// enums natifs Prisma, tous les champs de statut/rôle/type sont
// des String — validés côté application par les types TS
// existants, ex. UserRole, SubmissionStatus).
//
// Modèle hybride assumé : colonnes relationnelles pour tout ce qui
// doit être filtré/contraint/mis en relation, colonnes JSON pour
// les structures scientifiques imbriquées déjà stables (jamais
// recalculées par la base — les moteurs déterministes P1-P16
// restent la seule source de calcul).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// AUTHENTIFICATION / COMPTE
// ------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("student") // UserRole: student | supervisor | admin
  status       String    @default("active") // active | disabled
  firstName    String
  lastName     String?
  domain       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  studentProfile    StudentProfile?
  supervisorProfile SupervisorProfile?
  // Academic Assessment (mission dédiée) — distinct de supervisorProfile
  // (supervision de thèse) : un enseignant TP/TD/examen n'est pas
  // nécessairement un superviseur de mémoire, même s'il peut arriver
  // qu'une même personne cumule les deux rôles via deux profils distincts.
  teacherProfile    TeacherProfile?
  resetTokens       PasswordResetToken[]
  researchProjects  ResearchProject[]    @relation("ResearchOwner")
  journeySessions   JourneySession[]     @relation("JourneySessionOwner")
  stageApplications StageApplication[]   @relation("StageApplicant")
  cohortMemberships CohortMembership[]   @relation("CohortMembershipStudent")

  canevasList             SupervisionCanevas[]    @relation("CanevasSupervisor")
  invitationsSent         SupervisorInvitation[]  @relation("InvitationSupervisor")
  assignmentsAsStudent    SupervisionAssignment[] @relation("AssignmentStudent")
  assignmentsAsSupervisor SupervisionAssignment[] @relation("AssignmentSupervisor")
  submissionsAsStudent    Submission[]            @relation("SubmissionStudent")
  submissionsAsSupervisor Submission[]            @relation("SubmissionSupervisor")
  messagesSent            InboxMessage[]          @relation("MessageSender")
  messagesReceived        InboxMessage[]          @relation("MessageRecipient")
  feedbackGiven           FeedbackEntry[]         @relation("FeedbackSupervisor")
  notifications           Notification[]          @relation("NotificationUser")

  // Module Survey (additif, indépendant de Research) — voir plus bas.
  surveysOwned Survey[] @relation("SurveyOwner")

  // Feedback produit (Bloc 2) — voir plus haut, distinct de FeedbackEntry.
  productFeedback ProductFeedback[] @relation("ProductFeedbackUser")
  bugReports      BugReport[]       @relation("BugReportUser")
  featureRequests FeatureRequest[]  @relation("FeatureRequestUser")

  // Academic Assessment (mission dédiée)
  assignmentsAsTeacher   Assignment[]           @relation("AssignmentTeacher")
  assessmentSubmissions  AssessmentSubmission[] @relation("AssessmentSubmissionStudent")

  @@index([role])
}

model StudentProfile {
  userId      String   @id
  studyLevel  String?
  program     String?
  institution String?
  faculty     String?
  department  String?
  city        String?
  country     String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupervisorProfile {
  userId             String   @id
  fullName           String
  academicTitle      String?
  institution        String?
  faculty            String?
  department         String?
  domain             String?
  specialties        String? // liste séparée par virgules — pas de tableau natif SQLite
  activeAcademicYear String?
  isActive           Boolean  @default(true)
  professionalEmail  String?
  signature          String?
  activeCanevasId    String?
  verificationStatus String   @default("pending") // pending | verified | rejected
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// RECHERCHE SCIENTIFIQUE
//
// Une ligne par recherche. `researchData` = snapshot plat du
// Wizard (type Research/ResearchData, types/Research.ts).
// `payload` = structure scientifique complète (type
// ResearchProject, lib/core/research/ResearchTypes.ts — moteur
// protégé, jamais modifié). Les sous-collections qui étaient
// indexées par id de recherche en localStorage (instrument,
// dataset, bibliographie, annotations, cadre théorique, historique
// d'export) deviennent des colonnes JSON de CETTE même ligne,
// puisqu'elles partageaient déjà cette clé.
// ------------------------------------------------------------

model ResearchProject {
  id                   String   @id
  ownerId              String
  title                String
  researchType         String?
  level                String?
  status               String   @default("draft")
  domain               String?
  university           String?
  location             String?
  description          String?
  researchData         String // JSON (Research/ResearchData)
  payload              String // JSON (ResearchProject scientifique complet)
  instrument           String? // JSON (InstrumentRecord)
  dataset              String? // JSON (Dataset)
  annotations          String? // JSON (Record<blockId, AnnotationRecord>)
  bibliography         String? // JSON (BibliographyReference[])
  theoreticalFramework String? // JSON (TheoreticalFrameworkEntry[])
  exportHistory        String? // JSON (ExportHistoryEntry[])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner User @relation("ResearchOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  references         Reference[]
  referenceCitations ReferenceCitation[]
  claims             ResearchClaim[]

  @@index([ownerId])
}

// ------------------------------------------------------------
// BIBLIOGRAPHY & REFERENCE INTELLIGENCE (mission dédiée)
//
// Remplace/complète le blob JSON ResearchProject.bibliography (encore
// lu/écrit tel quel par app/api/research-state/route.ts pour la
// compatibilité descendante avec ResearchContext.tsx — mission §2,
// aucune régression) par un modèle relationnel réel : nécessaire pour
// la pagination/recherche serveur (mission §35, un blob JSON ne peut
// pas être paginé côté base), la déduplication, le suivi de
// vérification et la traçabilité citation↔référence↔claim, aucune de
// ces capacités n'existant sur le blob (author/year/title/type
// uniquement, jamais de DOI/ISBN/provenance/statut de vérification).
//
// PROVENANCE (mission §9) : vocabulaire DÉDIÉ, distinct de
// ProvenanceTag (lib/core/research/ResearchTypes.ts) — ProvenanceTag
// qualifie la provenance d'une VERSION D'ANALYSE entière (SUBJECT,
// AI_INFERENCE...), pas l'origine d'IMPORT d'une référence
// bibliographique précise (BIBTEX_IMPORT, DOI_LOOKUP...) : réutiliser
// ProvenanceTag tel quel aurait forcé une correspondance sémantique
// artificielle plutôt qu'un vocabulaire honnête.
// ------------------------------------------------------------

model Reference {
  id        String @id @default(cuid())
  projectId String

  title   String
  authors String // JSON string[] — jamais inventés, jamais reformatés au-delà d'une normalisation d'espaces (mission §16)
  year    Int?

  sourceType String // ReferenceSourceType : JOURNAL_ARTICLE | BOOK | ... (voir ReferenceTypes.ts)

  journal   String?
  publisher String?
  volume    String?
  issue     String?
  pages     String?

  doi      String?
  isbn     String?
  url      String?
  language String?

  // ReferenceVerificationStatus : VERIFIED | INFERRED | USER_PROVIDED |
  // AI_PROPOSED | TO_VERIFY | INVALID (mission §5) — ne doit JAMAIS être
  // VERIFIED simplement parce qu'une extraction IA a réussi (mission §23).
  verificationStatus String @default("TO_VERIFY")
  // ReferenceProvenance : USER_ENTERED | USER_IMPORTED | DOI_LOOKUP |
  // BIBTEX_IMPORT | RIS_IMPORT | AI_PROPOSED | SYSTEM_IMPORTED (mission §9)
  provenance String
  // Confiance IA (0..1) — uniquement pertinente si provenance=AI_PROPOSED, jamais pour une saisie manuelle.
  aiConfidence Decimal? @db.Decimal(4, 3)

  // Entrée brute d'origine (texte BibTeX/RIS, ou JSON de la proposition
  // IA validée) — traçabilité intégrale, jamais réinterprétée après coup.
  rawImportData String?

  // Doublon potentiel signalé (mission §15) — JAMAIS une suppression
  // automatique, seulement un lien que le chercheur peut examiner.
  duplicateOfId     String?
  duplicateOf       Reference?  @relation("ReferenceDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicatesOfThis  Reference[] @relation("ReferenceDuplicate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   ResearchProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations ReferenceCitation[]
  claims    ResearchClaim[]

  @@index([projectId])
  @@index([doi])
  @@index([verificationStatus])
}

// Nommé ReferenceCitation (jamais "Citation" seul) pour éviter toute
// ambiguïté future avec un usage non bibliographique du mot.
model ReferenceCitation {
  id          String  @id @default(cuid())
  projectId   String
  referenceId String? // null tant que non résolue (UNRESOLVED_CITATION, mission §17)

  rawText     String // ex. "(Kotler, 2017)" — jamais modifié après capture
  citedAuthor String? // extrait du texte brut, jamais inventé
  citedYear   Int?

  // CitationResolutionStatus : RESOLVED | UNRESOLVED | AMBIGUOUS (mission §17/§18)
  resolutionStatus String @default("UNRESOLVED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference Reference?      @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([referenceId])
}

// Préparatoire (mission §21/§48, traçabilité CLAIM → SOURCE →
// REFERENCE) — CRUD minimal volontaire, jamais générée automatiquement :
// le texte d'un claim est toujours saisi par le chercheur, jamais
// proposé par l'IA dans cette mission.
model ResearchClaim {
  id          String  @id @default(cuid())
  projectId   String
  text        String
  referenceId String? // null tant qu'aucune source réelle n'est reliée ("Source à ajouter ou vérifier", mission §21)

  // Mission 9 — Research Writing Engine — additifs, nullables pour tout
  // claim antérieur. Un claim reste TOUJOURS saisi par le chercheur
  // (jamais généré par l'IA, voir ClaimService.ts) ; ces deux champs
  // enregistrent seulement qu'une section de rédaction a RÉUTILISÉ ce
  // claim déjà existant comme matière citable, jamais l'inverse.
  claimType String? // "fact" | "figure" | "citation" | "interpretation"
  sectionId String? // id d'un WritingSection (stocké en JSON dans ResearchProject.payload, pas une table dédiée — voir WritingTypes.ts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference Reference?      @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([referenceId])
  @@index([sectionId])
}

// ------------------------------------------------------------
// SUPERVISION (migration des stores JSON fichier P16)
// ------------------------------------------------------------

model SupervisionCanevas {
  id              String   @id @default(cuid())
  supervisorId    String
  academicYear    String
  faculty         String?
  department      String?
  workTypes       String // JSON string[]
  steps           String // JSON CanevasStep[]
  hypothesisRules String? // JSON HypothesisCountRule[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supervisor User @relation("CanevasSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
}

model SupervisorInvitation {
  id           String    @id @default(cuid())
  code         String    @unique
  supervisorId String
  studentEmail String?
  researchId   String?
  status       String    @default("pending") // pending | accepted | expired | revoked
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  studentId    String?

  supervisor User @relation("InvitationSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
}

model SupervisionAssignment {
  id           String    @id @default(cuid())
  studentId    String
  supervisorId String
  researchId   String?
  status       String    @default("active") // active | ended
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  student    User @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor User @relation("AssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  // Pas de contrainte d'unicité sur (studentId, supervisorId, status) :
  // plusieurs affectations "ended" historiques entre la même paire
  // doivent rester possibles (fin puis nouvelle invitation plus
  // tard). L'absence de doublon "active" est garantie par
  // l'application (AssignmentStore.createAssignment vérifie avant
  // insertion) — cohérent avec Partie 33 du sprint P17 ("les
  // contraintes de base sont une seconde couche de sécurité, la
  // validation applicative reste nécessaire").
  @@index([supervisorId])
  @@index([studentId])
}

model Submission {
  id                   String    @id @default(cuid())
  researchId           String
  studentId            String
  supervisorId         String
  version              Int
  snapshot             String // JSON SubmissionSnapshot (project + instrument + theoreticalFramework)
  submittedAt          DateTime  @default(now())
  status               String    @default("submitted")
  studentMessage       String?
  reviewedAt           DateTime?
  reviewedBy           String?
  feedbackId           String?
  previousSubmissionId String?

  student    User @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor User @relation("SubmissionSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([researchId, studentId, version])
  @@index([studentId])
  @@index([supervisorId])
  @@index([researchId])
}

model InboxMessage {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  researchId   String?
  submissionId String?
  subject      String
  body         String
  type         String // feedback | correction | notification | validation | system
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  priority     String    @default("normal")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model FeedbackEntry {
  id               String    @id @default(cuid())
  submissionId     String
  supervisorId     String
  globalEvaluation String
  sections         String // JSON FeedbackSectionEntry[]
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  supervisor User @relation("FeedbackSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Correction {
  id           String    @id @default(cuid())
  submissionId String
  section      String
  description  String
  severity     String
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  discussion   String    @default("[]") // JSON CorrectionDiscussionEntry[]

  @@index([submissionId])
}

model SupervisorBrief {
  id                 String   @id @default(cuid())
  submissionId       String
  generatedAt        DateTime @default(now())
  generatedBy        String   @default("acadia")
  status             String   @default("generated")
  overallState       String
  strengths          String // JSON string[]
  inconsistencies    String // JSON string[]
  incompleteSections String // JSON string[]
  importantQuestions String // JSON string[]
  progressPercent    Int
  disclaimer         String

  @@index([submissionId])
}

model Notification {
  id                  String    @id @default(cuid())
  userId              String
  type                String
  title               String
  body                String
  relatedResearchId   String?
  relatedSubmissionId String?
  createdAt           DateTime  @default(now())
  readAt              DateTime?

  user User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String
  createdAt DateTime @default(now())
  error     String?
}

// ------------------------------------------------------------
// AUDIT (Partie 31 du sprint)
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  timestamp  DateTime @default(now())
  metadata   String? // JSON — jamais de mot de passe/clé/document sensible

  @@index([actorId])
  @@index([action])
}

// ------------------------------------------------------------
// FEEDBACK PRODUIT / SIGNALEMENT DE BUG / DEMANDE DE FONCTIONNALITÉ
// (Bloc 2 — préparation bêta "100 étudiants", 08/09/2026)
//
// Distinct de FeedbackEntry (évaluation académique superviseur →
// étudiant, voir plus bas) : ceci est le retour PRODUIT envoyé par
// les utilisateurs eux-mêmes sur ACADIA. Un seul widget de saisie
// (voir app/api/product/feedback/route.ts) route vers l'une de ces
// trois tables selon le type choisi par l'utilisateur — jamais un
// quatrième système parallèle : les événements de parcours réutilisent
// AuditLog tel quel (voir lib/server/analytics/ProductEvents.ts).
//
// `projectId` reste un identifiant libre (pas de relation Prisma) —
// il peut désigner un ResearchProject OU un Survey selon le contexte
// d'origine, deux tables distinctes dans ce schéma ; même choix que
// AuditLog.entityId, déjà établi pour cette raison.
// ------------------------------------------------------------

model ProductFeedback {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String // "question" | "satisfaction"
  message   String
  page      String?
  step      String?
  category  String? // UX | SCIENTIFIC | QUESTIONNAIRE | DATA | ANALYSIS | PERFORMANCE | TECHNICAL | PAYMENT | OTHER
  createdAt DateTime @default(now())

  user User @relation("ProductFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BugReport {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  page        String
  step        String?
  description String
  severity    String // LOW | MEDIUM | HIGH | BLOCKER
  category    String?
  status      String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  resolvedBy  String?

  user User @relation("BugReportUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model FeatureRequest {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String
  page        String?
  category    String?
  status      String   @default("SUBMITTED") // SUBMITTED | REVIEWING | PLANNED | IN_PROGRESS | DONE | DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("FeatureRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// MODULE SURVEY — moteur d'enquêtes institutionnelles
//
// Module additif, indépendant du système Research existant (aucune
// table ci-dessus modifiée au-delà de l'ajout non destructif de la
// relation User.surveysOwned). Générique : aucune institution n'est
// codée en dur — UNILU reste une donnée de démonstration comme une
// autre, jamais une valeur spéciale dans le schéma ou le code.
// ============================================================

model Survey {
  id                        String    @id @default(cuid())
  ownerId                   String
  title                     String
  description               String?
  objective                 String?
  problem                   String?
  targetAudience            String?
  institution               String?
  institutionLogoDocumentId String?
  status                    String    @default("draft") // draft | active | suspended | closed
  isAnonymous               Boolean   @default(false)
  targetResponses           Int?
  startDate                 DateTime?
  endDate                   DateTime?
  publicId                  String?   @unique
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  owner      User              @relation("SurveyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  questions  SurveyQuestion[]
  categories SurveyCategory[]
  targets    SurveyTarget[]
  collectors SurveyCollector[]
  links      SurveyLink[]
  responses  SurveyResponse[]
  events     SurveyEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([institution])
  @@index([createdAt])
}

model SurveyCategory {
  id       String @id @default(cuid())
  surveyId String
  label    String
  order    Int    @default(0)

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  targets   SurveyTarget[]
  responses SurveyResponse[]

  @@index([surveyId])
}

model SurveyQuestion {
  id                    String   @id @default(cuid())
  surveyId              String
  section               String?
  order                 Int      @default(0)
  type                  String // short_text|long_text|single_choice|multiple_choice|scale|boolean|number|age|date|institution|faculty|level|category
  text                  String
  required              Boolean  @default(true)
  variable              String? // variable méthodologique mesurée par cette question (moteur IA Survey)
  indicator             String? // indicateur concret rattaché à la variable (moteur IA Survey)
  visibleForCategoryIds String? // JSON string[] — vide/absent = visible pour toutes les catégories
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyOption {
  id         String @id @default(cuid())
  questionId String
  label      String
  value      String
  order      Int    @default(0)

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([questionId])
}

model SurveyTarget {
  id          String   @id @default(cuid())
  surveyId    String
  categoryId  String?
  label       String
  targetCount Int?
  createdAt   DateTime @default(now())

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  category SurveyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([surveyId])
}

model SurveyCollector {
  id        String   @id @default(cuid())
  surveyId  String
  label     String
  channel   String? // link | qr | whatsapp | email
  createdAt DateTime @default(now())

  survey Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  links  SurveyLink[]

  @@index([surveyId])
}

model SurveyLink {
  id          String    @id @default(cuid())
  surveyId    String
  publicId    String    @unique
  collectorId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  collector SurveyCollector? @relation(fields: [collectorId], references: [id], onDelete: SetNull)

  @@index([surveyId])
}

model SurveyResponse {
  id            String    @id @default(cuid())
  surveyId      String
  categoryId    String?
  respondentKey String? // empreinte non identifiante (dédoublonnage optionnel), jamais une donnée personnelle
  status        String    @default("in_progress") // in_progress | completed | abandoned
  institution   String?
  faculty       String?
  level         String?
  age           Int?
  sex           String?
  metadata      String? // JSON — informations sociodémographiques additionnelles définies par l'enquête
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  category SurveyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  answers  SurveyAnswer[]

  @@unique([surveyId, respondentKey]) // idempotence de la soumission (P20.5) — jamais deux réponses pour la même clé de soumission ; NULL autorisé plusieurs fois (Postgres)
  @@index([surveyId])
  @@index([categoryId])
  @@index([status])
  @@index([institution])
  @@index([faculty])
  @@index([startedAt])
}

model SurveyAnswer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  optionId   String?
  valueText  String?
  createdAt  DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

model SurveyEvent {
  id        String   @id @default(cuid())
  surveyId  String
  type      String // created | published | suspended | closed | response_received | exported
  metadata  String?
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([type])
}

// ------------------------------------------------------------
// SECURITY + AI COST FOUNDATION (mission dédiée)
//
// userId/projectId restent des identifiants LIBRES (pas de relation
// Prisma) — même choix qu'AuditLog.actorId/entityId ci-dessus, pour
// la même raison : éviter de coupler une table de suivi transverse à
// un cycle de vie FK (cascade/suppression) qui ne la concerne pas.
// ------------------------------------------------------------

// Journal central de tout appel IA — un appel = une ligne. Jamais un
// second système de tracking : ProductEvents (parcours produit) et
// AuditLog (sécurité) restent inchangés et continuent d'exister pour
// leurs usages respectifs ; AIUsageLedger est le seul endroit qui
// connaît les tokens/coûts/latence d'un appel OpenAI donné.
model AIUsageLedger {
  id                 String   @id @default(cuid())
  userId             String?
  projectId          String?
  anonymousSessionId String?
  operation          String // PREVIEW_ANALYSIS | DEEP_ANALYSIS | VARIABLE_ANALYSIS | METHODOLOGY | QUESTIONNAIRE_GENERATION | DOCUMENT_ANALYSIS | INTERPRETATION | CONCLUSION | OTHER
  model              String
  provider           String   @default("openai")
  inputTokens        Int?
  cachedInputTokens  Int?
  outputTokens       Int?
  estimatedCostUsd   Decimal? @db.Decimal(12, 6)
  actualCostUsd      Decimal? @db.Decimal(12, 6)
  latencyMs          Int?
  success            Boolean
  cacheHit           Boolean  @default(false)
  errorMessage       String? // message court, jamais une stack trace ni un secret
  requestId          String? // response.id renvoyé par OpenAI
  correlationId      String? // id généré par ACADIA, relie plusieurs appels d'une même action utilisateur
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([anonymousSessionId])
  @@index([operation])
  @@index([createdAt])
}

// Compteur de quota distribué (fenêtre glissante), utilisé par
// PostgresRateLimitStore (lib/server/security/RateLimitStore.ts) —
// la vraie protection cross-instance en environnement serverless.
// Le limiteur en mémoire existant (lib/server/security/RateLimiter.ts)
// reste la couche secondaire anti-rafale (sub-seconde, par instance).
model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// Cache d'analyses IA GÉNÉRIQUES (jamais de données privées — voir
// lib/server/ai/AnalysisCache.ts). Un seul type d'opération y est
// actuellement éligible (PREVIEW_ANALYSIS : entrée = sujet seul,
// aucune donnée de projet/document) — voir la garde explicite dans
// le code, pas seulement une convention de nommage.
model GenericAnalysisCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  operation       String
  normalizedInput String // texte normalisé, jamais une donnée personnelle
  resultJson      String // JSON du résultat mis en cache
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  lastHitAt       DateTime @default(now())

  @@index([operation])
}

// ------------------------------------------------------------
// CONVERSION + PAY-AS-YOU-PROGRESS (mission dédiée)
//
// userId/projectId restent des identifiants LIBRES (pas de relation
// Prisma) — même choix qu'AuditLog/AIUsageLedger, pour ne pas coupler
// une table transverse au cycle de vie FK d'un ResearchProject.
// projectId est nullable : un entitlement PEUT être "global compte"
// (aucun cas d'usage aujourd'hui, mais le modèle le permet sans
// migration future — voir mission §2, "le système doit pouvoir évoluer").
// ------------------------------------------------------------

// Ce que le chercheur a réellement débloqué — une ligne = un
// déblocage actif pour (userId, projectId, key). Jamais recalculé
// dynamiquement depuis Payment : la vérité d'accès vit ici, Payment
// n'est que la trace de la transaction qui a mené à ce déblocage
// (ou "beta_free" pendant la bêta — voir PricingConfig.ts).
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  key       String // EntitlementKey : PREVIEW | RESEARCH_ANALYSIS | METHODOLOGY | QUESTIONNAIRE | DATA_ANALYSIS | INTERPRETATION | WRITING | DEFENSE
  status    String   @default("active") // active | revoked
  source    String // beta_free | payment | admin_grant | promo
  paymentId String?
  grantedAt DateTime @default(now())

  @@unique([userId, projectId, key])
  @@index([userId])
  @@index([projectId])
}

// Trace de CHAQUE tentative de déblocage, réussie ou non — y compris
// pendant la bêta (montant 0, provider "beta_free") : l'architecture
// se comporte déjà comme s'il y avait un paiement réel (mission §4),
// pour ne pas avoir à réécrire ce flux quand un vrai fournisseur de
// paiement sera branché. idempotencyKey empêche un double paiement
// (double clic, double soumission) de créer deux transactions.
model Payment {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  entitlementKey String
  amountUsd      Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  status         String // pending | processing | succeeded | failed | cancelled | expired — voir lib/server/billing/payment/PaymentStatus.ts (source unique de vérité)
  provider       String // beta_free | mock | orange_money | airtel_money | cinetpay
  providerRef    String? // référence de transaction côté provider — sert à corréler un WebhookEvent à ce Payment
  idempotencyKey String   @unique
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

// ------------------------------------------------------------
// PAYMENT ENGINE (mission dédiée) — trace CHAQUE événement webhook reçu
// d'un fournisseur de paiement, réussi ou non. La contrainte unique
// (provider, providerEventId) EST le mécanisme d'idempotence : un même
// événement reçu 1, 2 ou 10 fois ne peut créer qu'UNE seule ligne ici,
// et donc ne peut déclencher qu'UN seul octroi d'entitlement (voir
// app/api/webhooks/payments/[provider]/route.ts).
//
// rawPayloadHash (jamais le payload brut complet, voir audit Mission 1
// §10) : un payload provider peut contenir un numéro de téléphone ou
// d'autres données personnelles — seul un hash est conservé, suffisant
// pour détecter un rejeu à l'identique en debug sans stocker de donnée
// personnelle en clair.
// ------------------------------------------------------------
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  paymentId       String?
  status          String    @default("received") // received | processed | failed | ignored
  rawPayloadHash  String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

// ============================================================
// ACADEMIC ASSESSMENT — CORE (mission dédiée, 14/09/2026)
//
// Audit préalable (voir rapport) : aucun modèle Assignment/Question/
// Rubric/Evaluation/Grade/Teacher/Institution n'existait. `Submission`
// existe déjà pour la supervision de mémoire (studentId/supervisorId/
// snapshot d'un ResearchProject) — domaine différent, jamais réutilisé
// ici : le nouveau modèle de soumission de copie s'appelle
// AssessmentSubmission pour éviter toute confusion. StudentProfile
// (déjà existant) EST réutilisé tel quel — un étudiant ACADIA n'a pas
// besoin d'un second profil pour l'Assessment.
//
// Statuts en String (pas d'enum Prisma) — convention déjà établie dans
// tout ce schéma (voir en-tête du fichier), validés côté application
// par les unions TS de lib/core/assessment/AssessmentTypes.ts.
// ============================================================

// ------------------------------------------------------------
// HIÉRARCHIE INSTITUTIONNELLE — minimale, seulement ce qu'il faut pour
// permettre plus tard la sélection en cascade Institution → Faculté →
// Programme → Promotion → Cours → Enseignant (mission §3). Aucune
// interface d'administration n'est construite dans cette mission — les
// lignes sont créées directement (script/DB) tant qu'un back-office
// n'existe pas.
// ------------------------------------------------------------

model Institution {
  id        String   @id @default(cuid())
  name      String
  city      String?
  country   String?
  createdAt DateTime @default(now())

  faculties       Faculty[]
  teacherProfiles TeacherProfile[]

  @@index([name])
}

model Faculty {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  createdAt     DateTime @default(now())

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  programs        Program[]
  teacherProfiles TeacherProfile[]

  @@index([institutionId])
}

// "Department / Program" (mission §2/§3) — un seul niveau, les deux
// termes désignant le même palier dans la hiérarchie demandée.
model Program {
  id        String   @id @default(cuid())
  facultyId String
  name      String
  createdAt DateTime @default(now())

  faculty         Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  cohorts         Cohort[]
  teacherProfiles TeacherProfile[]

  @@index([facultyId])
}

// "Cohort / Promotion" (mission §2/§3).
model Cohort {
  id           String   @id @default(cuid())
  programId    String
  name         String // ex. "L1 2025-2026"
  academicYear String?
  // Code de classe partagé par les enseignants aux étudiants pour
  // rejoindre leur promotion (mission Student Enrollment, retour
  // utilisateur post-Mission 7) — réutilisable par tous les étudiants
  // de la cohorte, jamais à usage unique (mission Google Classroom-like,
  // pas un système d'invitation nominative comme SupervisorInvitation).
  joinCode     String?  @unique
  createdAt    DateTime @default(now())

  program     Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  courses     Course[]
  assignments Assignment[]
  memberships CohortMembership[]

  @@index([programId])
}

// ------------------------------------------------------------
// COHORT MEMBERSHIP — le chaînon étudiant↔cohorte manquant depuis la
// Mission Student Submission Engine (gap explicitement documenté à
// l'époque, jamais comblé jusqu'ici). Une ligne = un étudiant
// appartient réellement à une promotion précise — c'est CE lien qui
// permet à "Mes TP" de savoir quels TP concernent quel étudiant, sans
// jamais deviner ni tout exposer.
// ------------------------------------------------------------

model CohortMembership {
  id        String   @id @default(cuid())
  studentId String
  cohortId  String
  joinedAt  DateTime @default(now())

  student User   @relation("CohortMembershipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([studentId, cohortId])
  @@index([studentId])
  @@index([cohortId])
}

model Course {
  id        String   @id @default(cuid())
  cohortId  String
  // Enseignant "propriétaire" du cours — optionnel : un cours peut
  // exister avant qu'un enseignant lui soit rattaché. Sélectionnable
  // dans le futur sélecteur uniquement si TeacherProfile.receivingEnabled
  // = true (mission §4/§20 — voir AssessmentDirectoryService).
  teacherId String?
  name      String
  createdAt DateTime @default(now())

  cohort      Cohort         @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  teacher     TeacherProfile? @relation(fields: [teacherId], references: [userId], onDelete: SetNull)
  assignments Assignment[]

  @@index([cohortId])
  @@index([teacherId])
}

// ------------------------------------------------------------
// TEACHER PROFILE — distinct de SupervisorProfile (supervision de
// mémoire, autre domaine, voir audit). receivingEnabled est LA règle
// fondamentale (mission §4) : un enseignant n'apparaît dans un
// sélecteur de destination que s'il l'a explicitement activé — jamais
// implicite, jamais activé par défaut.
// ------------------------------------------------------------

model TeacherProfile {
  userId           String   @id
  displayName      String?
  institutionId    String?
  facultyId        String?
  programId        String?
  status           String   @default("active") // active | disabled
  receivingEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  faculty     Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  program     Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  courses     Course[]

  @@index([institutionId])
  @@index([facultyId])
  @@index([programId])
  @@index([receivingEnabled])
}

// ------------------------------------------------------------
// ASSIGNMENT — seul type réellement activé : TP (mission §6). Les
// autres (TD/HOMEWORK/QUIZ/INTERROGATION/EXAM) existent dans le type
// TS AssignmentType pour préparer l'architecture, jamais exposés côté
// création tant que la validation applicative ne les autorise pas
// (voir AssignmentService.ts).
//
// DELETE POLICY (mission §26) : jamais de suppression réelle une fois
// des AssessmentSubmission existent — voir archiveAssignment() dans
// AssignmentService.ts, qui refuse le hard-delete dans ce cas et
// impose le statut "archived".
// ------------------------------------------------------------

model Assignment {
  id            String    @id @default(cuid())
  teacherId     String
  courseId      String
  cohortId      String // dénormalisé depuis Course.cohortId au moment de la création — simplifie le filtrage direct, voir limitations du rapport
  title         String
  description   String?
  instructions  String?
  type          String // AssignmentType : TP | TD | HOMEWORK | QUIZ | INTERROGATION | EXAM (TP seul activé)
  status        String    @default("draft") // AssignmentStatus : draft | published | closed | archived
  availableFrom DateTime?
  dueAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher     User                   @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohort      Cohort                 @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  questions   Question[]
  submissions AssessmentSubmission[]

  @@index([teacherId])
  @@index([courseId])
  @@index([cohortId])
  @@index([status])
}

// ------------------------------------------------------------
// QUESTION — VERSIONING (mission §8, exigence critique). Une question
// publiée n'est jamais modifiée en place : toute édition après
// publication crée une NOUVELLE ligne (version+1, même groupKey),
// l'ancienne recevant supersededAt. Une AssessmentAnswer référence
// TOUJOURS la version exacte qui était active au moment de la
// réponse — jamais recalculée, jamais réécrite. Le Rubric est lié 1:1
// à CETTE version précise (voir Rubric ci-dessous), garantissant
// qu'une vieille copie reste corrigeable avec la question ET le
// barème tels qu'ils existaient (mission §8, dernier paragraphe).
// ------------------------------------------------------------

model Question {
  id            String    @id @default(cuid())
  assignmentId  String
  groupKey      String // stable à travers les versions d'"une même" question logique
  version       Int       @default(1)
  supersededAt  DateTime? // null = version courante/active
  order         Int       @default(0)
  statement     String
  type          String // QuestionType : OPEN_TEXT | SHORT_ANSWER | NUMERIC | MULTIPLE_CHOICE | TRUE_FALSE | CALCULATION
  maxScore      Decimal   @db.Decimal(6, 2)
  // Repère pédagogique, PAS une chaîne à comparer exactement (mission
  // §10) — la future intelligence de correction évalue sémantiquement
  // question + expectedAnswer + rubric + réponse étudiant ensemble.
  expectedAnswer String?
  instructions   String?
  metadata       String? // JSON libre
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  rubric     Rubric?
  answers    AssessmentAnswer[]

  // Mission Assignment Builder + TP Intelligence — empêche deux versions
  // concurrentes de la même question logique (même groupKey) de partager
  // le même numéro de version : la transaction perdante d'un versioning
  // concurrent échoue proprement (contrainte unique) plutôt que de
  // produire silencieusement deux lignes "version 2" toutes deux
  // supersededAt=null (voir QuestionService.updateQuestion et le rapport,
  // §16 "Duplication/Concurrence").
  @@unique([assignmentId, groupKey, version])
  @@index([assignmentId])
  @@index([groupKey])
}

// ------------------------------------------------------------
// RUBRIC — un barème par VERSION de question (1:1), jamais partagé
// entre versions (mission §8/§9). La réponse modèle n'est qu'un repère
// parmi les formulations correctes possibles (mission §9, dernier
// paragraphe) — expectedElements sur chaque critère reste une liste de
// repères, jamais une exigence de formulation exacte.
// ------------------------------------------------------------

model Rubric {
  id         String   @id @default(cuid())
  questionId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
}

model RubricCriterion {
  id               String   @id @default(cuid())
  rubricId         String
  name             String
  description      String?
  maxScore         Decimal  @db.Decimal(6, 2)
  expectedElements String? // JSON string[] — repères, jamais une formulation exacte exigée
  weight           Decimal? @db.Decimal(5, 2)
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  rubric          Rubric                     @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criterionScores EvaluationCriterionScore[]

  @@index([rubricId])
}

// ------------------------------------------------------------
// ASSESSMENT SUBMISSION — nommée ainsi pour ne jamais être confondue
// avec le modèle Submission existant (supervision de mémoire, voir
// audit). Une resoumission ne fait jamais disparaître la précédente
// (mission §11) : elle crée une NOUVELLE ligne (version+1) plutôt que
// d'écraser — voir SubmissionService.ts pour la règle exacte
// (resoumission autorisée seulement depuis "draft" ou "returned").
// ------------------------------------------------------------

model AssessmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  version      Int       @default(1)
  status       String    @default("draft") // AssessmentSubmissionStatus : draft | submitted | under_review | graded | returned
  submittedAt  DateTime?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    User               @relation("AssessmentSubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  answers    AssessmentAnswer[]

  @@unique([assignmentId, studentId, version])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

// ------------------------------------------------------------
// ANSWER — préparée pour un contenu futur texte/photo/scan/PDF/OCR
// (mission §12) via attachmentRef (référence libre, jamais le binaire
// ici) — Document/OCRResult ne sont PAS construits maintenant (mission
// §24), seule cette référence existe pour ne pas bloquer leur ajout
// ultérieur sans migration destructive.
// ------------------------------------------------------------

model AssessmentAnswer {
  id             String   @id @default(cuid())
  submissionId   String
  questionId     String // pointe la version EXACTE de Question active au moment de la réponse
  order          Int      @default(0)
  answerText     String?
  answerData     String? // JSON — QCM/numérique/structuré
  attachmentRef  String? // référence future vers un document/scan — jamais le contenu binaire
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  evaluation Evaluation?

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
}

// ------------------------------------------------------------
// EVALUATION — AI_SCORE et HUMAN_SCORE JAMAIS écrasés l'un par l'autre
// (mission §13, règle absolue) : deux colonnes distinctes, toujours
// conservées. finalScore est déterminé par la décision humaine
// (accept/modify/reject) — jamais recalculé silencieusement ailleurs.
// AI proposes, teacher validates (mission §18) : needsHumanReview part
// à true par défaut, aucune Evaluation n'est "finalized" sans passage
// explicite par une décision humaine dans EvaluationService.ts.
// ------------------------------------------------------------

model Evaluation {
  id               String   @id @default(cuid())
  answerId         String   @unique
  aiScore          Decimal? @db.Decimal(6, 2)
  humanScore       Decimal? @db.Decimal(6, 2)
  finalScore       Decimal? @db.Decimal(6, 2)
  confidence       Decimal? @db.Decimal(4, 3) // 0..1
  needsHumanReview Boolean  @default(true)
  status           String   @default("ai_proposed") // EvaluationStatus : ai_proposed | human_review | accepted | modified | rejected | finalized
  // Modèle IA ayant produit aiScore — corrélation avec AIUsageLedger
  // (operation="ASSESSMENT_GRADING") sans dupliquer son suivi de coût.
  aiModel   String?
  // Proposition complète validée (JSON de AIGradingResult — mission AI
  // Grading Engine) : findings/evidence/limitations/warnings intégraux,
  // au-delà du texte condensé déjà stocké dans EvaluationFeedback.
  // Traçabilité uniquement — jamais réinterprété ni utilisé pour une
  // décision automatique.
  aiRawProposal String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer          AssessmentAnswer          @relation(fields: [answerId], references: [id], onDelete: Cascade)
  criterionScores EvaluationCriterionScore[]
  feedbacks       EvaluationFeedback[]

  @@index([status])
}

model EvaluationCriterionScore {
  id           String   @id @default(cuid())
  evaluationId String
  criterionId  String
  score        Decimal  @db.Decimal(6, 2)
  maxScore     Decimal  @db.Decimal(6, 2)
  confidence   Decimal? @db.Decimal(4, 3)
  evidence     String?
  comment      String?
  createdAt    DateTime @default(now())

  evaluation Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@index([criterionId])
}

// Nommé EvaluationFeedback (pas "Feedback" seul) pour ne jamais être
// confondu avec FeedbackEntry existant (évaluation académique
// superviseur → étudiant, autre domaine — voir audit). source distingue
// toujours l'origine réelle : un commentaire IA n'est jamais présenté
// comme un commentaire enseignant (mission §15, règle absolue).
model EvaluationFeedback {
  id           String   @id @default(cuid())
  evaluationId String
  source       String // FeedbackSource : ai | teacher
  text         String
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

// ============================================================
// PARCOURS GUIDÉ D'INTERPRÉTATION — interprétations enregistrées par compte.
// payload : instantané JSON (versionné) des décisions du chercheur ;
// les résultats sont recalculés à la reprise (jamais stockés comme faits).
// Le fichier de données (facultatif, avec consentement) est dans le stockage
// de documents ; sa propriété est portée par fileDocumentId.
// ============================================================
model JourneySession {
  id             String    @id
  ownerId        String
  title          String
  /// Moteur d'interprétation : "survey" (parcours général) ou "finance" (gestion financière). Jamais modifié après création.
  kind           String    @default("survey")
  status         String    @default("active")
  stage          String    @default("domain")
  schemaVersion  Int       @default(1)
  payload        String
  payloadBytes   Int       @default(0)
  revision       Int       @default(0)
  summary        String?
  fileName       String?
  fileSize       Int?
  fileSha256     String?
  fileDocumentId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastOpenedAt   DateTime?

  owner User @relation("JourneySessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
}

// ============================================================
// MNJ STAGE CONNECT — candidatures de stage (académique ou professionnel).
// Données personnelles de l'étudiant (consentement recueilli à l'envoi) ;
// visibles par l'étudiant lui-même et par les administrateurs uniquement.
// Le paiement du pack passe par le moteur de paiement (table Payment,
// projectId = "stage:<id>") ; paymentStatus en est le reflet métier.
// ============================================================
model StageApplication {
  id               String    @id @default(cuid())
  userId           String
  type             String // academique | professionnel
  status           String    @default("en_attente") // voir lib/core/stages/catalog.ts
  lastName         String
  postName         String
  firstName        String
  phone            String
  email            String
  university       String
  institutionId    String? // lib/core/stages/institutions.ts ; null = établissement saisi librement
  faculty          String // faculté générale (classement CRM)
  facultyName      String? // faculté ou filière telle que publiée par l'établissement
  department       String
  level            String
  studentNumber    String? // matricule, pour la vérification par la faculté
  graduationYear   Int?
  skills           String // JSON : compétences à acquérir
  objectives       String
  preferredCompany String?
  preferredCity    String?
  startMonth       String?
  consentAt        DateTime
  packAcceptedAt   DateTime?
  paymentStatus    String    @default("non_paye") // non_paye | en_attente | paye | paye_bureau | echoue
  paymentId        String?
  paymentMethod    String?
  packOptions      String    @default("[]") // JSON : options choisies (recommandation, assurance) — lib/core/stages/catalog.ts
  paidAt           DateTime?
  adminNotes       String?
  assignedCompany  String?
  // Suivi : chaque étape découle de ces faits (lib/core/stages/workflow.ts), jamais d'un statut saisi à la main.
  documentsReceived String    @default("[]") // JSON : libellés des documents reçus par MNJ
  companyAddress    String?
  tutorName         String? // maître de stage
  tutorRole         String?
  tutorPhone        String?
  tutorEmail        String?
  startDate         String? // AAAA-MM-JJ
  endDate           String? // AAAA-MM-JJ (inclus)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User              @relation("StageApplicant", fields: [userId], references: [id], onDelete: Cascade)
  attendance StageAttendance[]
  accesses   StageAccess[]

  @@index([userId])
  @@index([status])
  @@index([faculty])
  @@index([createdAt])
  @@index([university])
}

/// Présence d'un stagiaire pour une journée : arrivée et départ horodatés par le serveur, compte rendu
/// des activités au départ, confirmation éventuelle du maître de stage. Une ligne par jour.
model StageAttendance {
  id               String    @id @default(cuid())
  applicationId    String
  day              String // AAAA-MM-JJ (fuseau STAGE_TIMEZONE)
  arrivalAt        DateTime
  departureAt      DateTime?
  activities       String?
  tutorConfirmedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  application StageApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, day])
  @@index([applicationId])
}

/// Lien d'accès en lecture (faculté) ou de confirmation des présences (maître de stage). Seule l'empreinte
/// SHA-256 du jeton est conservée ; le lien n'est montré qu'une fois, à sa création.
model StageAccess {
  id            String    @id @default(cuid())
  kind          String // tuteur | faculte
  tokenHash     String    @unique
  label         String
  applicationId String? // tuteur : le dossier concerné
  university    String? // faculte : établissement (nom tel qu'enregistré dans les dossiers)
  facultyName   String? // faculte : faculté ou filière
  createdById   String
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  application StageApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@index([applicationId])
}
