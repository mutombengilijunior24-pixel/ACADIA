// ============================================================
// ACADIA — SCHÉMA DE BASE DE DONNÉES (P17)
//
// SQLite en développement (base réelle, transactionnelle, fichier
// local — aucun serveur externe requis, voir
// ACADIA_P17_PRODUCTION_ARCHITECTURE.md). PostgreSQL documenté
// comme cible de production : changer `provider` + `DATABASE_URL`
// suffit, ce schéma reste valide (SQLite ne supportant pas les
// enums natifs Prisma, tous les champs de statut/rôle/type sont
// des String — validés côté application par les types TS
// existants, ex. UserRole, SubmissionStatus).
//
// Modèle hybride assumé : colonnes relationnelles pour tout ce qui
// doit être filtré/contraint/mis en relation, colonnes JSON pour
// les structures scientifiques imbriquées déjà stables (jamais
// recalculées par la base — les moteurs déterministes P1-P16
// restent la seule source de calcul).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// AUTHENTIFICATION / COMPTE
// ------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("student") // UserRole: student | supervisor | admin
  status       String    @default("active") // active | disabled
  firstName    String
  lastName     String?
  domain       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  studentProfile    StudentProfile?
  supervisorProfile SupervisorProfile?
  resetTokens       PasswordResetToken[]
  researchProjects  ResearchProject[]    @relation("ResearchOwner")

  canevasList             SupervisionCanevas[]    @relation("CanevasSupervisor")
  invitationsSent         SupervisorInvitation[]  @relation("InvitationSupervisor")
  assignmentsAsStudent    SupervisionAssignment[] @relation("AssignmentStudent")
  assignmentsAsSupervisor SupervisionAssignment[] @relation("AssignmentSupervisor")
  submissionsAsStudent    Submission[]            @relation("SubmissionStudent")
  submissionsAsSupervisor Submission[]            @relation("SubmissionSupervisor")
  messagesSent            InboxMessage[]          @relation("MessageSender")
  messagesReceived        InboxMessage[]          @relation("MessageRecipient")
  feedbackGiven           FeedbackEntry[]         @relation("FeedbackSupervisor")
  notifications           Notification[]          @relation("NotificationUser")

  // Module Survey (additif, indépendant de Research) — voir plus bas.
  surveysOwned Survey[] @relation("SurveyOwner")

  // Feedback produit (Bloc 2) — voir plus haut, distinct de FeedbackEntry.
  productFeedback ProductFeedback[] @relation("ProductFeedbackUser")
  bugReports      BugReport[]       @relation("BugReportUser")
  featureRequests FeatureRequest[]  @relation("FeatureRequestUser")

  @@index([role])
}

model StudentProfile {
  userId      String   @id
  studyLevel  String?
  program     String?
  institution String?
  faculty     String?
  department  String?
  city        String?
  country     String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupervisorProfile {
  userId             String   @id
  fullName           String
  academicTitle      String?
  institution        String?
  faculty            String?
  department         String?
  domain             String?
  specialties        String? // liste séparée par virgules — pas de tableau natif SQLite
  activeAcademicYear String?
  isActive           Boolean  @default(true)
  professionalEmail  String?
  signature          String?
  activeCanevasId    String?
  verificationStatus String   @default("pending") // pending | verified | rejected
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// RECHERCHE SCIENTIFIQUE
//
// Une ligne par recherche. `researchData` = snapshot plat du
// Wizard (type Research/ResearchData, types/Research.ts).
// `payload` = structure scientifique complète (type
// ResearchProject, lib/core/research/ResearchTypes.ts — moteur
// protégé, jamais modifié). Les sous-collections qui étaient
// indexées par id de recherche en localStorage (instrument,
// dataset, bibliographie, annotations, cadre théorique, historique
// d'export) deviennent des colonnes JSON de CETTE même ligne,
// puisqu'elles partageaient déjà cette clé.
// ------------------------------------------------------------

model ResearchProject {
  id                   String   @id
  ownerId              String
  title                String
  researchType         String?
  level                String?
  status               String   @default("draft")
  domain               String?
  university           String?
  location             String?
  description          String?
  researchData         String // JSON (Research/ResearchData)
  payload              String // JSON (ResearchProject scientifique complet)
  instrument           String? // JSON (InstrumentRecord)
  dataset              String? // JSON (Dataset)
  annotations          String? // JSON (Record<blockId, AnnotationRecord>)
  bibliography         String? // JSON (BibliographyReference[])
  theoreticalFramework String? // JSON (TheoreticalFrameworkEntry[])
  exportHistory        String? // JSON (ExportHistoryEntry[])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner User @relation("ResearchOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ------------------------------------------------------------
// SUPERVISION (migration des stores JSON fichier P16)
// ------------------------------------------------------------

model SupervisionCanevas {
  id              String   @id @default(cuid())
  supervisorId    String
  academicYear    String
  faculty         String?
  department      String?
  workTypes       String // JSON string[]
  steps           String // JSON CanevasStep[]
  hypothesisRules String? // JSON HypothesisCountRule[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supervisor User @relation("CanevasSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
}

model SupervisorInvitation {
  id           String    @id @default(cuid())
  code         String    @unique
  supervisorId String
  studentEmail String?
  researchId   String?
  status       String    @default("pending") // pending | accepted | expired | revoked
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  studentId    String?

  supervisor User @relation("InvitationSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
}

model SupervisionAssignment {
  id           String    @id @default(cuid())
  studentId    String
  supervisorId String
  researchId   String?
  status       String    @default("active") // active | ended
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  student    User @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor User @relation("AssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  // Pas de contrainte d'unicité sur (studentId, supervisorId, status) :
  // plusieurs affectations "ended" historiques entre la même paire
  // doivent rester possibles (fin puis nouvelle invitation plus
  // tard). L'absence de doublon "active" est garantie par
  // l'application (AssignmentStore.createAssignment vérifie avant
  // insertion) — cohérent avec Partie 33 du sprint P17 ("les
  // contraintes de base sont une seconde couche de sécurité, la
  // validation applicative reste nécessaire").
  @@index([supervisorId])
  @@index([studentId])
}

model Submission {
  id                   String    @id @default(cuid())
  researchId           String
  studentId            String
  supervisorId         String
  version              Int
  snapshot             String // JSON SubmissionSnapshot (project + instrument + theoreticalFramework)
  submittedAt          DateTime  @default(now())
  status               String    @default("submitted")
  studentMessage       String?
  reviewedAt           DateTime?
  reviewedBy           String?
  feedbackId           String?
  previousSubmissionId String?

  student    User @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor User @relation("SubmissionSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([researchId, studentId, version])
  @@index([studentId])
  @@index([supervisorId])
  @@index([researchId])
}

model InboxMessage {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  researchId   String?
  submissionId String?
  subject      String
  body         String
  type         String // feedback | correction | notification | validation | system
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  priority     String    @default("normal")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model FeedbackEntry {
  id               String    @id @default(cuid())
  submissionId     String
  supervisorId     String
  globalEvaluation String
  sections         String // JSON FeedbackSectionEntry[]
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  supervisor User @relation("FeedbackSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Correction {
  id           String    @id @default(cuid())
  submissionId String
  section      String
  description  String
  severity     String
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  discussion   String    @default("[]") // JSON CorrectionDiscussionEntry[]

  @@index([submissionId])
}

model SupervisorBrief {
  id                 String   @id @default(cuid())
  submissionId       String
  generatedAt        DateTime @default(now())
  generatedBy        String   @default("acadia")
  status             String   @default("generated")
  overallState       String
  strengths          String // JSON string[]
  inconsistencies    String // JSON string[]
  incompleteSections String // JSON string[]
  importantQuestions String // JSON string[]
  progressPercent    Int
  disclaimer         String

  @@index([submissionId])
}

model Notification {
  id                  String    @id @default(cuid())
  userId              String
  type                String
  title               String
  body                String
  relatedResearchId   String?
  relatedSubmissionId String?
  createdAt           DateTime  @default(now())
  readAt              DateTime?

  user User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String
  createdAt DateTime @default(now())
  error     String?
}

// ------------------------------------------------------------
// AUDIT (Partie 31 du sprint)
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  timestamp  DateTime @default(now())
  metadata   String? // JSON — jamais de mot de passe/clé/document sensible

  @@index([actorId])
  @@index([action])
}

// ------------------------------------------------------------
// FEEDBACK PRODUIT / SIGNALEMENT DE BUG / DEMANDE DE FONCTIONNALITÉ
// (Bloc 2 — préparation bêta "100 étudiants", 08/09/2026)
//
// Distinct de FeedbackEntry (évaluation académique superviseur →
// étudiant, voir plus bas) : ceci est le retour PRODUIT envoyé par
// les utilisateurs eux-mêmes sur ACADIA. Un seul widget de saisie
// (voir app/api/product/feedback/route.ts) route vers l'une de ces
// trois tables selon le type choisi par l'utilisateur — jamais un
// quatrième système parallèle : les événements de parcours réutilisent
// AuditLog tel quel (voir lib/server/analytics/ProductEvents.ts).
//
// `projectId` reste un identifiant libre (pas de relation Prisma) —
// il peut désigner un ResearchProject OU un Survey selon le contexte
// d'origine, deux tables distinctes dans ce schéma ; même choix que
// AuditLog.entityId, déjà établi pour cette raison.
// ------------------------------------------------------------

model ProductFeedback {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String // "question" | "satisfaction"
  message   String
  page      String?
  step      String?
  category  String? // UX | SCIENTIFIC | QUESTIONNAIRE | DATA | ANALYSIS | PERFORMANCE | TECHNICAL | PAYMENT | OTHER
  createdAt DateTime @default(now())

  user User @relation("ProductFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BugReport {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  page        String
  step        String?
  description String
  severity    String // LOW | MEDIUM | HIGH | BLOCKER
  category    String?
  status      String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  resolvedBy  String?

  user User @relation("BugReportUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model FeatureRequest {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String
  page        String?
  category    String?
  status      String   @default("SUBMITTED") // SUBMITTED | REVIEWING | PLANNED | IN_PROGRESS | DONE | DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("FeatureRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// MODULE SURVEY — moteur d'enquêtes institutionnelles
//
// Module additif, indépendant du système Research existant (aucune
// table ci-dessus modifiée au-delà de l'ajout non destructif de la
// relation User.surveysOwned). Générique : aucune institution n'est
// codée en dur — UNILU reste une donnée de démonstration comme une
// autre, jamais une valeur spéciale dans le schéma ou le code.
// ============================================================

model Survey {
  id                        String    @id @default(cuid())
  ownerId                   String
  title                     String
  description               String?
  objective                 String?
  problem                   String?
  targetAudience            String?
  institution               String?
  institutionLogoDocumentId String?
  status                    String    @default("draft") // draft | active | suspended | closed
  isAnonymous               Boolean   @default(false)
  targetResponses           Int?
  startDate                 DateTime?
  endDate                   DateTime?
  publicId                  String?   @unique
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  owner      User              @relation("SurveyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  questions  SurveyQuestion[]
  categories SurveyCategory[]
  targets    SurveyTarget[]
  collectors SurveyCollector[]
  links      SurveyLink[]
  responses  SurveyResponse[]
  events     SurveyEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([institution])
  @@index([createdAt])
}

model SurveyCategory {
  id       String @id @default(cuid())
  surveyId String
  label    String
  order    Int    @default(0)

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  targets   SurveyTarget[]
  responses SurveyResponse[]

  @@index([surveyId])
}

model SurveyQuestion {
  id                    String   @id @default(cuid())
  surveyId              String
  section               String?
  order                 Int      @default(0)
  type                  String // short_text|long_text|single_choice|multiple_choice|scale|boolean|number|age|date|institution|faculty|level|category
  text                  String
  required              Boolean  @default(true)
  variable              String? // variable méthodologique mesurée par cette question (moteur IA Survey)
  indicator             String? // indicateur concret rattaché à la variable (moteur IA Survey)
  visibleForCategoryIds String? // JSON string[] — vide/absent = visible pour toutes les catégories
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId])
}

model SurveyOption {
  id         String @id @default(cuid())
  questionId String
  label      String
  value      String
  order      Int    @default(0)

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([questionId])
}

model SurveyTarget {
  id          String   @id @default(cuid())
  surveyId    String
  categoryId  String?
  label       String
  targetCount Int?
  createdAt   DateTime @default(now())

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  category SurveyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([surveyId])
}

model SurveyCollector {
  id        String   @id @default(cuid())
  surveyId  String
  label     String
  channel   String? // link | qr | whatsapp | email
  createdAt DateTime @default(now())

  survey Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  links  SurveyLink[]

  @@index([surveyId])
}

model SurveyLink {
  id          String    @id @default(cuid())
  surveyId    String
  publicId    String    @unique
  collectorId String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  collector SurveyCollector? @relation(fields: [collectorId], references: [id], onDelete: SetNull)

  @@index([surveyId])
}

model SurveyResponse {
  id            String    @id @default(cuid())
  surveyId      String
  categoryId    String?
  respondentKey String? // empreinte non identifiante (dédoublonnage optionnel), jamais une donnée personnelle
  status        String    @default("in_progress") // in_progress | completed | abandoned
  institution   String?
  faculty       String?
  level         String?
  age           Int?
  sex           String?
  metadata      String? // JSON — informations sociodémographiques additionnelles définies par l'enquête
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  survey   Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  category SurveyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  answers  SurveyAnswer[]

  @@unique([surveyId, respondentKey]) // idempotence de la soumission (P20.5) — jamais deux réponses pour la même clé de soumission ; NULL autorisé plusieurs fois (Postgres)
  @@index([surveyId])
  @@index([categoryId])
  @@index([status])
  @@index([institution])
  @@index([faculty])
  @@index([startedAt])
}

model SurveyAnswer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  optionId   String?
  valueText  String?
  createdAt  DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

model SurveyEvent {
  id        String   @id @default(cuid())
  surveyId  String
  type      String // created | published | suspended | closed | response_received | exported
  metadata  String?
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([type])
}

// ------------------------------------------------------------
// SECURITY + AI COST FOUNDATION (mission dédiée)
//
// userId/projectId restent des identifiants LIBRES (pas de relation
// Prisma) — même choix qu'AuditLog.actorId/entityId ci-dessus, pour
// la même raison : éviter de coupler une table de suivi transverse à
// un cycle de vie FK (cascade/suppression) qui ne la concerne pas.
// ------------------------------------------------------------

// Journal central de tout appel IA — un appel = une ligne. Jamais un
// second système de tracking : ProductEvents (parcours produit) et
// AuditLog (sécurité) restent inchangés et continuent d'exister pour
// leurs usages respectifs ; AIUsageLedger est le seul endroit qui
// connaît les tokens/coûts/latence d'un appel OpenAI donné.
model AIUsageLedger {
  id                 String   @id @default(cuid())
  userId             String?
  projectId          String?
  anonymousSessionId String?
  operation          String // PREVIEW_ANALYSIS | DEEP_ANALYSIS | VARIABLE_ANALYSIS | METHODOLOGY | QUESTIONNAIRE_GENERATION | DOCUMENT_ANALYSIS | INTERPRETATION | CONCLUSION | OTHER
  model              String
  provider           String   @default("openai")
  inputTokens        Int?
  cachedInputTokens  Int?
  outputTokens       Int?
  estimatedCostUsd   Decimal? @db.Decimal(12, 6)
  actualCostUsd      Decimal? @db.Decimal(12, 6)
  latencyMs          Int?
  success            Boolean
  cacheHit           Boolean  @default(false)
  errorMessage       String? // message court, jamais une stack trace ni un secret
  requestId          String? // response.id renvoyé par OpenAI
  correlationId      String? // id généré par ACADIA, relie plusieurs appels d'une même action utilisateur
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([anonymousSessionId])
  @@index([operation])
  @@index([createdAt])
}

// Compteur de quota distribué (fenêtre glissante), utilisé par
// PostgresRateLimitStore (lib/server/security/RateLimitStore.ts) —
// la vraie protection cross-instance en environnement serverless.
// Le limiteur en mémoire existant (lib/server/security/RateLimiter.ts)
// reste la couche secondaire anti-rafale (sub-seconde, par instance).
model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// Cache d'analyses IA GÉNÉRIQUES (jamais de données privées — voir
// lib/server/ai/AnalysisCache.ts). Un seul type d'opération y est
// actuellement éligible (PREVIEW_ANALYSIS : entrée = sujet seul,
// aucune donnée de projet/document) — voir la garde explicite dans
// le code, pas seulement une convention de nommage.
model GenericAnalysisCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  operation       String
  normalizedInput String // texte normalisé, jamais une donnée personnelle
  resultJson      String // JSON du résultat mis en cache
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  lastHitAt       DateTime @default(now())

  @@index([operation])
}

// ------------------------------------------------------------
// CONVERSION + PAY-AS-YOU-PROGRESS (mission dédiée)
//
// userId/projectId restent des identifiants LIBRES (pas de relation
// Prisma) — même choix qu'AuditLog/AIUsageLedger, pour ne pas coupler
// une table transverse au cycle de vie FK d'un ResearchProject.
// projectId est nullable : un entitlement PEUT être "global compte"
// (aucun cas d'usage aujourd'hui, mais le modèle le permet sans
// migration future — voir mission §2, "le système doit pouvoir évoluer").
// ------------------------------------------------------------

// Ce que le chercheur a réellement débloqué — une ligne = un
// déblocage actif pour (userId, projectId, key). Jamais recalculé
// dynamiquement depuis Payment : la vérité d'accès vit ici, Payment
// n'est que la trace de la transaction qui a mené à ce déblocage
// (ou "beta_free" pendant la bêta — voir PricingConfig.ts).
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  key       String // EntitlementKey : PREVIEW | RESEARCH_ANALYSIS | METHODOLOGY | QUESTIONNAIRE | DATA_ANALYSIS | INTERPRETATION | WRITING | DEFENSE
  status    String   @default("active") // active | revoked
  source    String // beta_free | payment | admin_grant | promo
  paymentId String?
  grantedAt DateTime @default(now())

  @@unique([userId, projectId, key])
  @@index([userId])
  @@index([projectId])
}

// Trace de CHAQUE tentative de déblocage, réussie ou non — y compris
// pendant la bêta (montant 0, provider "beta_free") : l'architecture
// se comporte déjà comme s'il y avait un paiement réel (mission §4),
// pour ne pas avoir à réécrire ce flux quand un vrai fournisseur de
// paiement sera branché. idempotencyKey empêche un double paiement
// (double clic, double soumission) de créer deux transactions.
model Payment {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  entitlementKey String
  amountUsd      Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  status         String // pending | succeeded | failed
  provider       String // beta_free | mobile_money | stripe (futurs fournisseurs réels)
  providerRef    String? // référence externe, une fois un vrai fournisseur branché
  idempotencyKey String   @unique
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
