# Copier ce fichier en .env.local et renseigner de vraies valeurs.
# .env.local n'est jamais commité (voir .gitignore).
# Catégories (P17) : DATABASE / AUTH / AI / EMAIL / STORAGE / APP / SECURITY / FUTURE PAYMENTS

# ------------------------------------------------------------
# DATABASE
# Développement : SQLite locale, aucun serveur à provisionner.
# Production : remplacer par une URL PostgreSQL managée et changer
# `provider` dans prisma/schema.prisma — voir
# ACADIA_P17_PRODUCTION_ARCHITECTURE.md.
# ------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
# Secret utilisé pour signer les sessions d'authentification (HMAC).
# Générer une valeur aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------
# AI
# ------------------------------------------------------------
# Clé API OpenAI — utilisée uniquement côté serveur (jamais exposée au client).
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------
# EMAIL (P16/P17, fournisseur réel préparé en P18-FINAL) — AUCUN
# fournisseur n'est configuré aujourd'hui. Tant que ces variables
# sont vides, ACADIA utilise NoOpEmailProvider (aucun envoi réel,
# chaque tentative journalisée comme "not_configured"). Pour activer
# Resend une fois un compte réel créé : EMAIL_PROVIDER="resend",
# EMAIL_API_KEY=<clé Resend>, EMAIL_FROM="ACADIA <noreply@votre-domaine>".
# Voir ACADIA_EMAIL_SETUP.md.
# ------------------------------------------------------------
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_DOMAIN=

# ------------------------------------------------------------
# STORAGE (P17, fournisseur réel préparé en P18-FINAL) — AUCUN
# fournisseur cloud n'est configuré. Tant que STORAGE_PROVIDER est
# vide, ACADIA utilise le stockage de développement local
# (data/documents/). Pour activer Cloudflare R2 une fois un compte
# réel créé : STORAGE_PROVIDER="r2" + les 4 identifiants ci-dessous.
# Voir ACADIA_STORAGE_SETUP.md.
# ------------------------------------------------------------
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_R2_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ------------------------------------------------------------
# MONITORING (P18-FINAL, Sentry préparé) — AUCUN DSN configuré
# aujourd'hui. Sans SENTRY_DSN, instrumentation.ts n'initialise rien.
# NEXT_PUBLIC_SENTRY_DSN (côté client) n'est PAS un secret : elle est
# destinée à être publique, contrairement à SENTRY_DSN (serveur).
# Voir ACADIA_MONITORING_SETUP.md.
# ------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
# URL publique de l'application — utilisée pour construire les liens
# dans les emails/notifications (invitation, etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------
# SECURITY (P17)
# Redis/KV pour un rate limiting distribué en production — non
# configuré (l'implémentation de développement est en mémoire
# process, voir lib/server/security/RateLimiter.ts).
# ------------------------------------------------------------
RATE_LIMIT_KV_URL=

# ------------------------------------------------------------
# FUTURE PAYMENTS (préparation uniquement — aucun paiement actif,
# voir ACADIA_P16_AUDIT.md / entitlements P14-P17)
# ------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
